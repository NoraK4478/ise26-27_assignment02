root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
max_line_length = 120
ktlint_code_style = ktlint_official
ij_kotlin_allow_trailing_comma = false
ij_kotlin_allow_trailing_comma_on_call_site = false
# Allow block bodies such as the one of isEmpty(); ktlint_official would otherwise require an
# expression body for every function that only returns a single expression.
ktlint_standard_function-expression-body = disabled
